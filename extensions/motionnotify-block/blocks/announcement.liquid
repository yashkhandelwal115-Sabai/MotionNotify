</div>

<script src="{{ 'motionnotify.js' | asset_url }}" defer></script>
<link rel="stylesheet" href="{{ 'motionnotify.css' | asset_url }}">

{% schema %}
{
  "name": "MotionNotify Banner",
  "target": "section",
  "settings": []
}
{% endschema %}
